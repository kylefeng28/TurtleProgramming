doctype html
html
	head
		meta(charset='utf-8')
		title Sandbox
		link(rel='stylesheet', href='./resources/iframe-style.css')

		#test

		// p5.js
		script(type='text/javascript', src='./resources/p5.min.js')

		// script(type='text/javascript', src="./resources/p5.gibber.min.js")
		// script.
			function setup() { window["setup1"](); } function draw() { window["draw1"](); }
		// script.
			var setup1 = function(){}; var draw1 = function(){};

		// Coffeescript
		script(type='text/javascript', src='./resources/coffee-script.js')

		// TODO load opal asynchronously to not slow down page loading time
		// Opal
		script(type='text/javascript', src='./resources/opal.js')
		script(type='text/javascript', src='./resources/opal-parser.js')
		script(type='text/javascript', src='./resources/opal-native.js')
		script(type='text/javascript') Opal.load("opal-parser")

		// Skulpt
		script(type='text/javascript', src='https://skulpt.org/js/skulpt.min.js')
		script(type='text/javascript', src='https://skulpt.org/js/skulpt-stdlib.js')
		script.
			// Configure skulpt
			Sk.pre = 'output';
			Sk.configure({
				output: function(text) { console.log(text); },
				read: function(x) {
					if (Sk.builtinFiles === undefined || Sk.builtinFiles['files'][x] === undefined) {
						throw "File not found: '" + x + "'"; }
					return Sk.builtinFiles['files'][x];
				},
				// Retain globals, otherwise they will be lost
				retainglobals: true
			});
			// (Sk.TurtleGraphics || (Sk.TurtleGraphics = {})).target = 'mycanvas';

		// Starlight
		// script(src='//cdnjs.cloudflare.com/ajax/libs/babel-core/5.8.34/browser.min.js')
		script(src='./resources/starlight.js', data-run-script-tags)

		// Please JS
		script(type='text/javascript', src='https://unpkg.com/pleasejs@0.4.2/dist/Please.js')

		// Turtle
		script(type='text/javascript', src='./src/turtle.js')
		script(type='text/javascript', src='./src/turtle-helpers.js')
		script(type='text/ruby', src='./src/turtle-opal.rb')
		script(type='text/javascript', src='./src/turtle-skulpt.js')
		script(type='text/lua', src='./src/turtle-starlight.lua')

